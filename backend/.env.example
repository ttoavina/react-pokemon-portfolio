APP_NAME=portfolio-backend
ENV=development

# Set this for Atlas. <db_username> / <db_password> are auto-replaced with MONGO_USER / MONGO_PASSWORD.
# Leave empty to use the local Mongo fallback below.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.vl4e1.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

MONGO_USER=ttoavina
MONGO_PASSWORD=ttoavina
MONGO_DB=portfolio

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_AUTH_SOURCE=admin

CORS_ORIGINS=http://localhost:5173

# LiteLLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=500

# Provider API keys — pick the one matching LLM_MODEL
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Admin key — required header X-Admin-Key to call /stats/*
ADMIN_KEY=change-me-please-long-random
